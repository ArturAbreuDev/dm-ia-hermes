{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/fluxo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/publish-due",
      "schedule": "0 15 * * *"
    }
  ]
}
